{
  "name": "Libro de visitas",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Sitio (nginx)",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "if [ ! -f .env ]; then cp .env.example .env && pw=$(od -An -N16 -tx1 /dev/urandom | tr -d '[:space:]') && sed -i \"s/^DB_PASSWORD=.*/DB_PASSWORD=${pw}/\" .env; fi",
  "postStartCommand": "docker compose up -d --build --wait",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
